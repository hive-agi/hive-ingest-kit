{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        ;; hive-dsl — Result monad, error taxonomy.
        io.github.hive-agi/hive-dsl  {:mvn/version "0.5.24"}
        ;; hive-spi — the ingestion seam: ISource / IParserRule ports, the
        ;; Document value object, the owner-scoped registry.
        io.github.hive-agi/hive-spi  {:mvn/version "1.1.0"}
        ;; hive-html — HTML page to text, headings, links and metadata.
        io.github.hive-agi/hive-html {:mvn/version "0.1.2"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; Clojars publishing. version = the repo's VERSION file.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.15"}}
          :ns-default hive-build.api}}}
